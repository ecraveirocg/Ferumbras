// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model Character {
  id        Int           @id @default(autoincrement())
  name      String        @unique
  sex       Sex
  level     Int
  vocation  Vocation
  world     String        @default("")
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt
  sessions  HuntSession[]
  gear      CharacterGear?
}

model Spot {
  id       Int           @id @default(autoincrement())
  name     String        @unique
  sessions HuntSession[]
}

model CharacterGear {
  id          Int       @id @default(autoincrement())
  characterId Int       @unique
  character   Character @relation(fields: [characterId], references: [id], onDelete: Cascade)
  slots       String    @default("{}") @db.Text
  runes       String    @default("[]") @db.Text
  pots        String    @default("[]") @db.Text
  presets     String    @default("[]") @db.Text
  updatedAt   DateTime  @updatedAt
}

model TibiaItemCache {
  id        Int      @id @default(autoincrement())
  name      String   @unique
  image     String?  @db.Text
  stats     String?  @db.Text
  updatedAt DateTime @updatedAt

  @@index([name])
}

model HuntSession {
  id           Int       @id @default(autoincrement())
  characterId  Int
  character    Character @relation(fields: [characterId], references: [id])
  spotId       Int
  spot         Spot      @relation(fields: [spotId], references: [id])
  startedAt    DateTime
  duration     Int // minutes
  goldEarned Int       @default(0)
  xpGained     Int       @default(0)
  notes        String?   @db.Text
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
}

model Goal {
  id          Int       @id @default(autoincrement())
  type        GoalType  @default(GENERAL)
  title       String
  itemImage   String?   @db.Text
  description String?   @db.Text
  target      Int?
  current     Int       @default(0)
  unit        String?
  deadline    DateTime?
  completed   Boolean   @default(false)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
}

enum GoalType {
  GENERAL
  ITEM
  LEVEL
}

enum Sex {
  MALE
  FEMALE
}

enum Vocation {
  ELITE_KNIGHT
  ROYAL_PALADIN
  MASTER_SORCERER
  ELDER_DRUID
  EXALTED_MONK
}
